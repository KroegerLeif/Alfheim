{
  "name": "alfheim",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "check-types": "pnpm -r --filter=!@alfheim/docs-portal exec tsc --noEmit && pnpm --filter @alfheim/docs-portal run check-types",
    "lint": "pnpm -r --if-present run lint",
    "vitest": "pnpm -r exec vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "next": ">=16.3.6",
      "devalue": ">=5.9.3",
      "brace-expansion": ">=5.0.11"
    }
  }
}
