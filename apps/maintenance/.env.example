# ==============================================================================
# alfheim: Maintenance Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./maintenance.db
# DATABASE_URL=postgresql://user:password@localhost:5432/maintenance

# OIDC Authentication
OIDC_ISSUER_URL=http://auth.alfheim.loegien.localhost
OIDC_AUDIENCE=alfheim

# OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-tempo-or-jaeger-ip:4317

# --- FRONTEND CONFIGURATION ---
# These variables are needed at build time by Docker to inject into the client code
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OIDC_ISSUER=http://auth.alfheim.loegien.localhost
NEXT_PUBLIC_OIDC_CLIENT_ID=maintenance-frontend
