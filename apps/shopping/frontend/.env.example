# alfheim: Shopping Frontend Environment Variables
PORT=3010

# URL of the local Shopping FastAPI backend API
NEXT_PUBLIC_API_URL=http://localhost:8010

# URL of the local Pantry FastAPI backend API (used for product catalog lookups and registry)
NEXT_PUBLIC_PANTRY_API_URL=http://localhost:8000

# Generic OIDC Authorization Code + PKCE flow (browser-facing)
NEXT_PUBLIC_OIDC_ISSUER=http://auth.alfheim.loegien.localhost
NEXT_PUBLIC_OIDC_CLIENT_ID=shopping-frontend
