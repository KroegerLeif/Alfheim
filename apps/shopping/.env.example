# ==============================================================================
# loeger-os: Shopping Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8010
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/shopping
# Fallback for local development without docker PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./shopping.db

# Keycloak Authentication (i18n-ready authentication boundaries)
KEYCLOAK_URL=http://loeger-os.local/auth
KEYCLOAK_REALM=loeger-os
KEYCLOAK_CLIENT_ID=shopping-backend

# Pantry Integration URL
PANTRY_BACKEND_URL=http://localhost:8000

# --- FRONTEND CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://localhost:8010
