# ==============================================================================
# alfheim: Shopping Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8010
DATABASE_URL=postgresql+asyncpg://shopping_user:postgres@localhost:5432/alfheim_shopping
# Fallback for local development without docker PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./shopping.db

# Generic OIDC Authentication (Zitadel)
OIDC_ISSUER_URL=http://auth.alfheim.loegien.localhost
OIDC_AUDIENCE=alfheim

# Pantry Integration URL
PANTRY_BACKEND_URL=http://localhost:8000

# --- FRONTEND CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://localhost:8010
