# ==============================================================================
# alfheim: Chat Backend Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

PORT=8080
ENVIRONMENT=development

# --- DATABASE ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat_db?sslmode=disable
MIGRATIONS_DIR=migrations

# --- KEYCLOAK OIDC ---
KEYCLOAK_BASE_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=alfheim
KEYCLOAK_CLIENT_ID=chat-backend
# Defaults to KEYCLOAK_PUBLIC_URL/auth/realms/alfheim in production, matching the
# other backends' external Caddy-facing issuer.
KEYCLOAK_PUBLIC_ISSUER=http://api.alfheim.loegien.localhost/auth/realms/alfheim
# Defaults to KEYCLOAK_CLIENT_ID above if left unset.
KEYCLOAK_EXPECTED_AUDIENCE=chat-backend

# --- MODEL BLOCK API KEY ENCRYPTION (AES-256-GCM) ---
# Must be a base64-encoded 32-byte key, e.g. generated with: openssl rand -base64 32
CHAT_ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY_ID=v1

# --- BOOTSTRAP MODEL BLOCK (idempotent upsert on first startup only; leave empty
# to start with no preconfigured model) ---
CHAT_BOOTSTRAP_PROVIDER=ollama
CHAT_BOOTSTRAP_OLLAMA_URL=
CHAT_BOOTSTRAP_MODEL=
CHAT_BOOTSTRAP_API_KEY=
