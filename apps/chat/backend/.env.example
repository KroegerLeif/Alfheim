# ==============================================================================
# alfheim: Chat Backend Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

PORT=8080
ENVIRONMENT=development

# --- DATABASE ---
DATABASE_URL=postgres://chat_user:postgres@localhost:5432/alfheim_chat?sslmode=disable
MIGRATIONS_DIR=migrations

# --- GENERIC OIDC ---
OIDC_ISSUER_URL=http://auth.alfheim.loegien.localhost
OIDC_AUDIENCE=alfheim

# --- MODEL BLOCK API KEY ENCRYPTION (AES-256-GCM) ---
# Must be a base64-encoded 32-byte key, e.g. generated with: openssl rand -base64 32
CHAT_ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY_ID=v1

# --- BOOTSTRAP MODEL BLOCK (idempotent upsert on first startup only; leave empty
# to start with no preconfigured model) ---
CHAT_BOOTSTRAP_PROVIDER=ollama
CHAT_BOOTSTRAP_OLLAMA_URL=
CHAT_BOOTSTRAP_MODEL=
CHAT_BOOTSTRAP_API_KEY=

# --- MCP SERVER REGISTRY (seeded/re-synced on every startup) ---
# Comma-separated app_slug=internal_url pairs pointing at the Fach-Apps' FastMCP
# endpoints, reachable only inside the Docker network (never routed through Caddy).
CHAT_MCP_SERVERS=pantry=http://pantry-backend:8000/mcp,chores=http://chores-backend:8000/mcp,maintenance=http://maintenance-backend:8000/mcp
