# ==============================================================================
# alfheim: Chat Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8080
ENVIRONMENT=development
DATABASE_URL=postgres://postgres:postgres@chat-db:5432/chat_db?sslmode=disable
KEYCLOAK_BASE_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=alfheim
KEYCLOAK_CLIENT_ID=chat-backend
KEYCLOAK_PUBLIC_ISSUER=http://api.alfheim.loegien.localhost/auth/realms/alfheim
KEYCLOAK_EXPECTED_AUDIENCE=chat-backend

# S3 Object Storage
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_URL=http://api.alfheim.loegien.localhost/storage

# Model block encryption (base64-encoded 32-byte key)
CHAT_ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY_ID=v1

# MCP servers
CHAT_MCP_SERVERS=pantry=http://pantry-backend:8000/mcp,chores=http://chores-backend:8000/mcp,maintenance=http://maintenance-backend:8000/mcp

# --- FRONTEND CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://api.alfheim.loegien.localhost/api/v1/chat
NEXT_PUBLIC_KEYCLOAK_URL=http://api.alfheim.loegien.localhost/auth
NEXT_PUBLIC_FRONTEND_URL=http://alfheim.loegien.localhost
