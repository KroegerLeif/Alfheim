# ==============================================================================
# loeger-os: Pantry Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8000
DATABASE_URL=sqlite:///./pantry.db
# DATABASE_URL=postgresql://user:password@localhost:5432/pantry

# Keycloak Authentication
KEYCLOAK_URL=http://your-unifi-nas-ip:8080/auth
KEYCLOAK_REALM=loeger-os
KEYCLOAK_CLIENT_ID=pantry-backend

# OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-tempo-or-jaeger-ip:4317

# --- FRONTEND CONFIGURATION ---
# This variable is needed at build time by Docker to inject into the client code
NEXT_PUBLIC_API_URL=http://localhost:8000