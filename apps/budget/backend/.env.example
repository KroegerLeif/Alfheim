PROJECT_NAME="Budget & Treasury Service"
ENVIRONMENT="development"
DEBUG=true

# Database connection URL (asyncpg URL for async SQLAlchemy)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/budget"

# Keycloak OIDC Configuration
KEYCLOAK_URL="http://keycloak:8080/auth"
KEYCLOAK_PUBLIC_URL="http://api.alfheim.loegien.localhost/auth"
KEYCLOAK_REALM="alfheim"

# S3 Storage Configuration
S3_ENDPOINT_URL="http://localhost:9000"
S3_BUCKET_NAME="budget-receipts"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
