# Library Microservice Environment Variables

# Database connection
DATABASE_URL=postgresql+asyncpg://library_user:postgres@localhost:5432/alfheim_library

# Generic OIDC Authentication (Zitadel)
OIDC_ISSUER_URL=http://auth.alfheim.loegien.localhost
OIDC_AUDIENCE=alfheim

# Frontend OIDC Configuration
NEXT_PUBLIC_OIDC_ISSUER=http://auth.alfheim.loegien.localhost
NEXT_PUBLIC_OIDC_CLIENT_ID=library-frontend
NEXT_PUBLIC_API_URL=http://api.alfheim.loegien.localhost/api/v1/library
