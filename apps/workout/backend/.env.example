# Project configuration
PROJECT_NAME="Workout Tracker"
ENVIRONMENT="development"
DEBUG=True

# Database connection URL (asyncpg driver required for SQLAlchemy async)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5434/workout"

# Keycloak OIDC authentication config
KEYCLOAK_URL="http://keycloak:8080/auth"
KEYCLOAK_PUBLIC_URL="http://api.alfheim.loegien.localhost/auth"
KEYCLOAK_REALM="alfheim"
KEYCLOAK_JWKS_URL=""

# OpenTelemetry configuration
OTEL_ENABLED=False
OTEL_SERVICE_NAME="workout-backend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_INSECURE=True
