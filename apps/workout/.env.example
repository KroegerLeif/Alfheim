# ==============================================================================
# alfheim: Workout Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8000
DATABASE_URL=postgresql+asyncpg://workout_user:postgres@localhost:5432/alfheim_workout

# Generic OIDC Authentication (Zitadel)
OIDC_ISSUER_URL=http://api.alfheim.loegien.localhost/auth
OIDC_AUDIENCE=alfheim

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=workout-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- FRONTEND CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://api.alfheim.loegien.localhost/workout/api/v1
NEXT_PUBLIC_OIDC_ISSUER=http://api.alfheim.loegien.localhost/auth
NEXT_PUBLIC_OIDC_CLIENT_ID=workout-frontend
