# ==============================================================================
# loeger-os: Chores Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/chores

# Keycloak Authentication
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=loeger-os

# OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- FRONTEND CONFIGURATION ---
# This variable is needed at build time by Docker to inject into the client code
NEXT_PUBLIC_API_URL=/api/v1/chores
