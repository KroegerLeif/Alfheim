# ==============================================================================
# alfheim: Chores Module Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# --- BACKEND CONFIGURATION ---
PORT=8000
DATABASE_URL=postgresql+asyncpg://chores_user:postgres@localhost:5432/alfheim_chores

# Generic OIDC Authentication
OIDC_ISSUER_URL=http://localhost:8080
OIDC_AUDIENCE=alfheim

# OpenTelemetry Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- FRONTEND CONFIGURATION ---
# These variables are needed at build time by Docker to inject into the client code
NEXT_PUBLIC_API_URL=/api/v1/chores
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8080
NEXT_PUBLIC_OIDC_CLIENT_ID=chores-frontend
