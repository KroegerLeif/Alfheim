# Project configuration
PROJECT_NAME="Chores Tracker"
ENVIRONMENT="development"
DEBUG=True

# Database connection URL (asyncpg driver required for SQLAlchemy async)
DATABASE_URL="postgresql+asyncpg://chores_user:postgres@localhost:5432/alfheim_chores"

# Generic OIDC authentication config
OIDC_ISSUER_URL="http://localhost:8080"
OIDC_AUDIENCE="alfheim"
OIDC_JWKS_URL=""

# OpenTelemetry configuration
OTEL_ENABLED=False
OTEL_SERVICE_NAME="chores-backend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_INSECURE=True
