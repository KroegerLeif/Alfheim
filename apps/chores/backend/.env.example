# Project configuration
PROJECT_NAME="Chores Tracker"
ENVIRONMENT="development"
DEBUG=True

# Database connection URL (asyncpg driver required for SQLAlchemy async)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5435/chores"

# Keycloak OIDC authentication config
KEYCLOAK_URL="http://keycloak:8080/auth"
KEYCLOAK_PUBLIC_URL="http://alfheim/auth"
KEYCLOAK_REALM="alfheim"
KEYCLOAK_JWKS_URL=""

# OpenTelemetry configuration
OTEL_ENABLED=False
OTEL_SERVICE_NAME="chores-backend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_INSECURE=True
