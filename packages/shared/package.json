{
  "name": "@alfheim/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./assets": {
      "types": "./src/assets/index.ts",
      "default": "./src/assets/index.ts"
    },
    "./assets/*": "./src/assets/*",
    "./app-shell": {
      "types": "./src/features/app-shell/index.ts",
      "default": "./src/features/app-shell/index.ts"
    },
    "./i18n/navigation": {
      "types": "./src/features/i18n/next/navigation.ts",
      "default": "./src/features/i18n/next/navigation.ts"
    },
    "./i18n/proxy": {
      "types": "./src/features/i18n/next/proxy.ts",
      "default": "./src/features/i18n/next/proxy.ts"
    },
    "./i18n/request": {
      "types": "./src/features/i18n/next/request.ts",
      "default": "./src/features/i18n/next/request.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": ">=0.300.0",
    "next": "^15.0.0 || ^16.0.0",
    "next-intl": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.9",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.3",
    "next": "^16.4.6",
    "next-intl": "^4.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
