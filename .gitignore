# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS Files
.DS_Store
Thumbs.db

# Environment & Secrets
**/.env
**/.env.*
**/.env.local
!**/.env.example
**/.envrc
*.key
*.pem
*.cert
*.crt
*.p12
*.pfx
# Installer-generated trust material (--tls internal). The directories stay
# tracked via .gitkeep so the compose bind-mount sources always exist.
infrastructure/ca/*
!infrastructure/ca/.gitkeep
infrastructure/caddy/pki/*
!infrastructure/caddy/pki/.gitkeep

# Local data & storage
**/data/
**/rustfs_data/
**/caddy_data/
**/caddy_config/
**/volumes/

# Python Virtual Environments
**/.venv/

# Build/Cache/Logs
**/node_modules/
**/.next/
**/tsconfig.tsbuildinfo
**/__pycache__/
**/.ruff_cache/
**/.pytest_cache/
**/.mypy_cache/
**/htmlcov/
**/*.egg-info/
**/.turbo/
**/playwright-report/
.pnpm-store/
# Build outputs (none of these directories hold tracked sources)
**/dist/
**/build/
**/out/
# Installer binary from `go build` in tools/installer
/tools/installer/alfheim-setup
**/*.log
**/.coverage
**/.coverage.*
**/coverage.xml
**/coverage/
coverage.out
**/coverage.out
*.db
*.sqlite
*.sqlite3

# Git worktrees and local agent settings
.worktrees/
.claude/worktrees/
.claude/settings.local.json
.worktreeinclude

# Favicon bundle copied into each frontend's public/ by
# packages/shared/scripts/sync-brand-assets.mjs (predev/prebuild); the canonical files live in
# packages/shared/src/assets/favicon_io/.
**/public/favicon.ico
**/public/favicon-16x16.png
**/public/favicon-32x32.png
**/public/apple-touch-icon.png
**/public/android-chrome-192x192.png
**/public/android-chrome-512x512.png
**/public/site.webmanifest
