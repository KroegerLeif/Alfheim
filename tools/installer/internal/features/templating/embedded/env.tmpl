{{- $on := .Onboarding -}}
{{- $tls := .TLS -}}
# ==============================================================================
# alfheim: Production Environment
# Generated by alfheim-setup {{ .Version }} on {{ .GeneratedStamp }}.
#
# This file contains every credential for this installation. Keep it readable
# by its owner only (chmod 600) and never commit it.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE & IAM
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ envQuote (.Secret "POSTGRES_PASSWORD") }}
POSTGRES_DB=postgres

ZITADEL_DB_HOST=postgres-core
ZITADEL_DB_PORT=5432
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel_user
ZITADEL_DB_PASSWORD={{ envQuote (.Secret "ZITADEL_DB_PASSWORD") }}

# The masterkey must be exactly 32 characters and must never be rotated on an
# existing instance: doing so makes the Zitadel database unreadable.
ZITADEL_MASTERKEY={{ envQuote (.Secret "ZITADEL_MASTERKEY") }}
ZITADEL_EXTERNALDOMAIN={{ $on.AuthHost }}
ZITADEL_EXTERNALPORT={{ .ExternalPort }}
ZITADEL_EXTERNALSECURE={{ $on.Secure }}

ZITADEL_ADMIN_EMAIL={{ $on.AdminEmail }}
# The login name Zitadel is bootstrapped with is the admin e-mail itself, so
# the operator logs in with the address they entered instead of guessing an
# `admin@auth.<domain>` style name.
ZITADEL_ADMIN_USER={{ $on.AdminEmail }}
ZITADEL_ADMIN_PASSWORD={{ envQuote (.Secret "ZITADEL_ADMIN_PASSWORD") }}
ZITADEL_FIRSTINSTANCE_ORG_NAME=Alfheim
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=${ZITADEL_ADMIN_USER}
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD={{ envQuote (.Secret "ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD") }}

# The bootstrap machine user alfheim-setup provisions OIDC clients with. Its
# personal access token is written by Zitadel only on first init
# (ZITADEL_FIRSTINSTANCE_PATPATH); the installer copies it here right after,
# so a lost machinekey file does not strand provisioning on a re-run.
ZITADEL_BOOTSTRAP_USERNAME=alfheim-bootstrap
ZITADEL_BOOTSTRAP_PAT=

# Filled in by the installer's Zitadel provisioning step, between the Edge &
# Identity phase and the Core & Application Stack phase. A fresh render
# always carries the placeholder so `docker compose config` never warns about
# an unset variable before provisioning has run.
ZITADEL_PROJECT_ID=__PROVISIONED__
OIDC_AUDIENCE=__PROVISIONED__
ALFHEIM_WEB_CLIENT_ID=__PROVISIONED__
GRAFANA_OIDC_CLIENT_ID=__PROVISIONED__
GRAFANA_OIDC_CLIENT_SECRET=__PROVISIONED__

# RustFS / MinIO S3 central storage
S3_ROOT_USER=alfheim
S3_ROOT_PASSWORD={{ envQuote (.Secret "S3_ROOT_PASSWORD") }}
S3_ACCESS_KEY=alfheim
S3_SECRET_KEY={{ envQuote (.Secret "S3_SECRET_KEY") }}
S3_ENDPOINT_URL=http://minio:9000
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=budget-receipts
S3_PUBLIC_URL={{ $on.BaseURL }}/storage

# ------------------------------------------------------------------------------
# 2. CORE & SERVICE DATABASE CREDENTIALS
# ------------------------------------------------------------------------------
DASHBOARD_POSTGRES_USER=dashboard_user
DASHBOARD_POSTGRES_PASSWORD={{ envQuote (.Secret "DASHBOARD_POSTGRES_PASSWORD") }}
DASHBOARD_POSTGRES_DB=alfheim_dashboard

HOUSEHOLD_POSTGRES_USER=household_user
HOUSEHOLD_POSTGRES_PASSWORD={{ envQuote (.Secret "HOUSEHOLD_POSTGRES_PASSWORD") }}
HOUSEHOLD_POSTGRES_DB=alfheim_household

# Shared secret for service-to-service calls to the household backend's
# /internal/* API. Caddy never routes /internal/*, so it is only reachable
# from inside the Docker networks.
ALFHEIM_INTERNAL_TOKEN={{ envQuote (.Secret "ALFHEIM_INTERNAL_TOKEN") }}

PANTRY_POSTGRES_USER=pantry_user
PANTRY_POSTGRES_PASSWORD={{ envQuote (.Secret "PANTRY_POSTGRES_PASSWORD") }}
PANTRY_POSTGRES_DB=alfheim_pantry

SHOPPING_POSTGRES_USER=shopping_user
SHOPPING_POSTGRES_PASSWORD={{ envQuote (.Secret "SHOPPING_POSTGRES_PASSWORD") }}
SHOPPING_POSTGRES_DB=alfheim_shopping

MAINTENANCE_POSTGRES_USER=maintenance_user
MAINTENANCE_POSTGRES_PASSWORD={{ envQuote (.Secret "MAINTENANCE_POSTGRES_PASSWORD") }}
MAINTENANCE_POSTGRES_DB=alfheim_maintenance

CHORES_POSTGRES_USER=chores_user
CHORES_POSTGRES_PASSWORD={{ envQuote (.Secret "CHORES_POSTGRES_PASSWORD") }}
CHORES_POSTGRES_DB=alfheim_chores

BUDGET_POSTGRES_USER=budget_user
BUDGET_POSTGRES_PASSWORD={{ envQuote (.Secret "BUDGET_POSTGRES_PASSWORD") }}
BUDGET_POSTGRES_DB=alfheim_budget

CHAT_POSTGRES_USER=chat_user
CHAT_POSTGRES_PASSWORD={{ envQuote (.Secret "CHAT_POSTGRES_PASSWORD") }}
CHAT_POSTGRES_DB=alfheim_chat
CHAT_ENCRYPTION_KEY={{ envQuote (.Secret "CHAT_ENCRYPTION_KEY") }}
CHAT_ENCRYPTION_KEY_ID=v1

WORKOUT_POSTGRES_USER=workout_user
WORKOUT_POSTGRES_PASSWORD={{ envQuote (.Secret "WORKOUT_POSTGRES_PASSWORD") }}
WORKOUT_POSTGRES_DB=alfheim_workout

LIBRARY_POSTGRES_USER=library_user
LIBRARY_POSTGRES_PASSWORD={{ envQuote (.Secret "LIBRARY_POSTGRES_PASSWORD") }}
LIBRARY_POSTGRES_DB=alfheim_library

# Explicitly constructed DATABASE_URL connections for Python AsyncPG backends.
# When left empty, services construct them from the POSTGRES_* variables above.
DASHBOARD_DATABASE_URL=
HOUSEHOLD_DATABASE_URL=
PANTRY_DATABASE_URL=
SHOPPING_DATABASE_URL=
MAINTENANCE_DATABASE_URL=
CHORES_DATABASE_URL=
BUDGET_DATABASE_URL=
CHAT_DATABASE_URL=
WORKOUT_DATABASE_URL=
LIBRARY_DATABASE_URL=

# Additional service configuration
PANTRY_BACKEND_URL=http://pantry-backend:8000
CHAT_MCP_SERVERS=pantry=http://pantry-backend:8000/mcp,chores=http://chores-backend:8000/mcp,maintenance=http://maintenance-backend:8000/mcp

# External API keys for enrichment features (optional; leave empty to disable)
GOOGLE_BOOKS_API_KEY=
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 3. DOMAIN, GATEWAY & AUTHENTICATION
# ------------------------------------------------------------------------------
ALFHEIM_BASE_URL={{ $on.BaseURL }}
DOMAIN={{ $on.BaseDomain }}
HOST_HEADER={{ $on.AppHost }}
ALFHEIM_HOST={{ $on.AppHost }}

IMAGE_REGISTRY={{ $on.Registry }}
IMAGE_REPO={{ $on.Repo }}
IMAGE_TAG={{ $on.ImageTag }}

# ------------------------------------------------------------------------------
# 4. TLS / INGRESS CERTIFICATES
# Strategy: {{ $tls.Strategy }}
# ------------------------------------------------------------------------------
ALFHEIM_TLS_STRATEGY={{ $tls.Strategy }}
{{- if $tls.ACMEEmail }}
ACME_EMAIL={{ $tls.ACMEEmail }}
{{- else }}
ACME_EMAIL=
{{- end }}
{{- if eq $tls.Strategy.String "hetzner" }}
# Consumed by the Caddy hetzner DNS module via {env.HETZNER_API_TOKEN}.
HETZNER_API_TOKEN={{ envQuote $tls.APIToken }}
CLOUDFLARE_API_TOKEN=
{{- else if eq $tls.Strategy.String "cloudflare" }}
HETZNER_API_TOKEN=
# Consumed by the Caddy cloudflare DNS module via {env.CLOUDFLARE_API_TOKEN}.
CLOUDFLARE_API_TOKEN={{ envQuote $tls.APIToken }}
{{- else }}
HETZNER_API_TOKEN=
CLOUDFLARE_API_TOKEN=
{{- end }}
{{- if eq $tls.Strategy.String "custom" }}
# Host directory bind-mounted into the gateway at /etc/caddy/certs.
ALFHEIM_CERT_MOUNT={{ $tls.CertSource.MountSpec }}
{{- else }}
ALFHEIM_CERT_MOUNT=
{{- end }}
{{- if eq $tls.Strategy.String "internal" }}
CADDY_TLS_DIRECTIVE=tls internal
# Public copy of the root CA alfheim-setup generated for this install. Every
# backend trusts it in addition to the system store, so server-to-server OIDC
# calls to the HTTPS issuer verify. Host copy: infrastructure/ca/.
ALFHEIM_EXTRA_CA_FILE={{ .ExtraCAFile }}
{{- else }}
CADDY_TLS_DIRECTIVE=
ALFHEIM_EXTRA_CA_FILE=
{{- end }}

NEXT_PUBLIC_FRONTEND_URL=${ALFHEIM_BASE_URL}

OIDC_ISSUER_URL={{ $on.IssuerURL }}

NEXT_PUBLIC_OIDC_ISSUER={{ $on.IssuerURL }}

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{ envQuote (.Secret "GRAFANA_ADMIN_PASSWORD") }}
# GRAFANA_OIDC_CLIENT_ID / _SECRET are provisioned above, alongside the other
# Zitadel-generated credentials.
# URL-encoded ${ALFHEIM_BASE_URL}/grafana/login, used as the post_logout_redirect_uri
# query parameter of Zitadel's end_session endpoint (compose.prod.yaml).
GRAFANA_SIGNOUT_REDIRECT_URL={{ urlQuery (print $on.BaseURL "/grafana/login") }}

# Frontend API URLs are not configured here: compose.prod.yaml derives each
# frontend's runtime NEXT_PUBLIC_API_URL from ALFHEIM_BASE_URL.
