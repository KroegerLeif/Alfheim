# =============================================================================
# alfheim: Caddy Ingress Gateway
# Generated by alfheim-setup {{ .Version }} on {{ .GeneratedStamp }}.
# Re-run the installer with --reconfigure to regenerate this file.
# =============================================================================

{{- $tls := .TLS }}
{{- $on := .Onboarding }}

# Global options
{
	admin off
{{- if $tls.Strategy.UsesDNSChallenge }}
	# Automatic HTTPS is Caddy's default and must not be disabled here, as it
	# drives DNS-01 issuance. The API token is read from the environment, so
	# this file never contains a credential.
{{- if $tls.ACMEEmail }}
	email {{ $tls.ACMEEmail }}
{{- end }}
	acme_dns {{ $tls.Strategy.DNSProvider }} {env.{{ $tls.Strategy.TokenEnvVar }}}
	# Certificate management stays on, but Caddy's own blanket HTTP->HTTPS
	# redirect is disabled: without this, any site here that manages a TLS
	# certificate makes Caddy install a catch-all redirect on port 80 for
	# EVERY host that isn't explicitly routed elsewhere — including this
	# container's own healthcheck hitting http://127.0.0.1/livez, which has
	# no matching certificate and fails the TLS handshake, so the healthcheck
	# never passes (reproduced and confirmed locally). The friendly redirect
	# real visitors expect on the bare domain is added explicitly below
	# instead of relying on this automatic behaviour.
	auto_https disable_redirects
{{- else if eq $tls.Strategy.String "internal" }}
	# Certificates are issued locally; no ACME account is involved.
	local_certs
	# Nothing inside the container benefits from trusting the root; clients
	# import infrastructure/ca/alfheim-root-ca.crt instead.
	skip_install_trust
	# Sign with the root CA alfheim-setup generated
	# (infrastructure/caddy/pki, mounted read-only at /etc/caddy/pki), so
	# backends and browsers can trust one stable, known root. Caddy derives
	# and renews its own intermediate from it. The CA id is deliberately not
	# Caddy's default "local": an install upgraded from plain HTTP may still
	# hold a "local" intermediate and leaf certificates in caddy_data signed
	# by Caddy's previously auto-generated root, which Caddy would keep
	# serving and which nothing trusts.
	pki {
		ca alfheim {
			name "Alfheim Local CA"
			root {
				cert /etc/caddy/pki/root.crt
				key /etc/caddy/pki/root.key
			}
		}
	}
	# See the comment on the DNS-01 branch above: this stops Caddy's own
	# managed-HTTPS redirect from swallowing the container's plain-HTTP
	# healthcheck on 127.0.0.1.
	auto_https disable_redirects
{{- else }}
	auto_https off
{{- end }}
}

{{- define "tlsDirective" }}
{{- if eq .Strategy.String "internal" }}
	tls {
		issuer internal {
			ca alfheim
		}
	}
{{- else if eq .Strategy.String "custom" }}
	tls {{ .CertSource.ContainerChainFile }} {{ .CertSource.ContainerKeyFile }}
{{- end }}
{{- end }}

# =============================================================================
# 0. IDENTITY PROVIDER DOMAIN (Zitadel OIDC)
# Zitadel is served on its own dedicated host; it does not support sub-path
# hosting. The issuer therefore is the bare origin of this domain.
# =============================================================================
{{ $on.Scheme }}://{{ $on.AuthHost }} {
{{- template "tlsDirective" $tls }}

	# Defense in depth: /internal/* is the service-to-service API authenticated
	# by ALFHEIM_INTERNAL_TOKEN and must never be reachable from outside.
	handle /internal/* {
		respond 404
	}

	reverse_proxy zitadel:8080 {
		# Zitadel speaks gRPC-Web / HTTP/2 to its own frontend and API.
		transport http {
			versions h2c 1.1
		}
	}
}
{{- if $on.Secure }}

# Explicit redirect, since auto_https disable_redirects (see global options)
# no longer adds one automatically: a visitor on plain HTTP still lands on
# HTTPS, but 127.0.0.1 (the container's own healthcheck) is left alone.
http://{{ $on.AuthHost }} {
	redir {{ $on.Scheme }}://{{ $on.AuthHost }}{uri} permanent
}
{{- end }}

# =============================================================================
# 1. FRONTEND DOMAIN
# =============================================================================
{{ $on.Scheme }}://{{ $on.AppHost }} {
{{- template "tlsDirective" $tls }}

	# Dedicated ingress healthcheck endpoint, isolated from downstream services.
	handle /livez {
		respond "OK" 200
	}

	# Service-to-service API (ALFHEIM_INTERNAL_TOKEN) is internal only and is
	# never proxied to any upstream.
	handle /internal/* {
		respond 404
	}

	# Exact locale redirects for bare base paths.
	redir /pantry /pantry/en 302
	redir /pantry/ /pantry/en 302
	redir /shopping /shopping/en 302
	redir /shopping/ /shopping/en 302
	redir /maintenance /maintenance/en 302
	redir /maintenance/ /maintenance/en 302
	redir /chores /chores/de 302
	redir /chores/ /chores/de 302
	redir /library /library/en 302
	redir /library/ /library/en 302
	redir /workout /workout/de 302
	redir /workout/ /workout/de 302
	redir /chat /chat/de 302
	redir /chat/ /chat/de 302
	redir /budget /budget/en 302
	redir /budget/ /budget/en 302

	# API gateway proxies on the frontend domain, so browsers can issue
	# relative /api/v1/... calls without a CORS preflight.
	#
	# Caddy sorts handle and handle_path blocks together by path length
	# (longest first) and runs only the first match, so these Tier-1
	# household & roles routes win over the generic /api/v1* dashboard route
	# below. The path is forwarded unchanged: the household backend serves
	# /api/v1/households and /api/v1/profile itself. No app slug is a prefix
	# of "households" or "profile", so no /api/v1/<slug>* rule can take them.
	handle /api/v1/households* {
		reverse_proxy household-backend:8080
	}
	handle /api/v1/profile* {
		reverse_proxy household-backend:8080
	}
{{- range .APIRoutes }}
	handle_path /api/v1/{{ .Slug }}* {
		rewrite * /api/v1{path}
		reverse_proxy {{ .Upstream }}
	}
	handle_path /{{ .Slug }}/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy {{ .Upstream }}
	}
{{- end }}

	# Central dashboard control plane.
	handle_path /api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy dashboard-backend:8080
	}

	# Observability.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Household & roles core frontend (Next.js basePath /household).
	handle /household* {
		reverse_proxy household-frontend:3000
	}

	# Application frontends.
{{- range .APIRoutes }}
	handle /{{ .Slug }}* {
		reverse_proxy {{ .Slug }}-frontend:3000
	}
{{- end }}

	# Dashboard frontend serves everything else.
	handle {
		reverse_proxy dashboard-frontend:3000
	}
}
{{- if $on.Secure }}

# See the identity provider domain block above for why this is explicit.
http://{{ $on.AppHost }} {
	redir {{ $on.Scheme }}://{{ $on.AppHost }}{uri} permanent
}
{{- end }}
