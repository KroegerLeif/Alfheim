# =============================================================================
# alfheim: Caddy Ingress Gateway
# Generated by alfheim-setup v0.0.0-test on 2026-03-01T12:00:00Z.
# Re-run the installer with --reconfigure to regenerate this file.
# =============================================================================

# Global options
{
	admin off
	# Caddy's internal CA issues on demand; no ACME account is involved.
	local_certs
}

# =============================================================================
# 0. IDENTITY PROVIDER DOMAIN (Zitadel OIDC)
# Zitadel is served on its own dedicated host; it does not support sub-path
# hosting. The issuer therefore is the bare origin of this domain.
# =============================================================================
http://auth.loegien.localhost {
	tls internal

	reverse_proxy zitadel:8080 {
		# Zitadel speaks gRPC-Web / HTTP/2 to its own frontend and API.
		transport http {
			versions h2c 1.1
		}
	}
}

# =============================================================================
# 1. FRONTEND DOMAIN
# =============================================================================
http://alfheim.loegien.localhost {
	tls internal

	# Dedicated ingress healthcheck endpoint, isolated from downstream services.
	handle /livez {
		respond "OK" 200
	}

	# Exact locale redirects for bare base paths.
	redir /pantry /pantry/en 302
	redir /pantry/ /pantry/en 302
	redir /shopping /shopping/en 302
	redir /shopping/ /shopping/en 302
	redir /maintenance /maintenance/en 302
	redir /maintenance/ /maintenance/en 302
	redir /chores /chores/de 302
	redir /chores/ /chores/de 302
	redir /library /library/en 302
	redir /library/ /library/en 302
	redir /workout /workout/de 302
	redir /workout/ /workout/de 302
	redir /chat /chat/de 302
	redir /chat/ /chat/de 302
	redir /budget /budget/en 302
	redir /budget/ /budget/en 302

	# API gateway proxies on the frontend domain, so browsers can issue
	# relative /api/v1/... calls without a CORS preflight.
	handle_path /api/v1/pantry* {
		rewrite * /api/v1{path}
		reverse_proxy pantry-backend:8000
	}
	handle_path /pantry/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy pantry-backend:8000
	}
	handle_path /api/v1/shopping* {
		rewrite * /api/v1{path}
		reverse_proxy shopping-backend:8000
	}
	handle_path /shopping/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy shopping-backend:8000
	}
	handle_path /api/v1/maintenance* {
		rewrite * /api/v1{path}
		reverse_proxy maintenance-backend:8000
	}
	handle_path /maintenance/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy maintenance-backend:8000
	}
	handle_path /api/v1/chores* {
		rewrite * /api/v1{path}
		reverse_proxy chores-backend:8000
	}
	handle_path /chores/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy chores-backend:8000
	}
	handle_path /api/v1/budget* {
		rewrite * /api/v1{path}
		reverse_proxy budget-backend:8000
	}
	handle_path /budget/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy budget-backend:8000
	}
	handle_path /api/v1/workout* {
		rewrite * /api/v1{path}
		reverse_proxy workout-backend:8000
	}
	handle_path /workout/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy workout-backend:8000
	}
	handle_path /api/v1/library* {
		rewrite * /api/v1{path}
		reverse_proxy library-backend:8080
	}
	handle_path /library/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy library-backend:8080
	}
	handle_path /api/v1/chat* {
		rewrite * /api/v1{path}
		reverse_proxy chat-backend:8080
	}
	handle_path /chat/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy chat-backend:8080
	}

	# Central dashboard control plane.
	handle_path /api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy dashboard-backend:8080
	}

	# Observability.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Application frontends.
	handle /pantry* {
		reverse_proxy pantry-frontend:3000
	}
	handle /shopping* {
		reverse_proxy shopping-frontend:3000
	}
	handle /maintenance* {
		reverse_proxy maintenance-frontend:3000
	}
	handle /chores* {
		reverse_proxy chores-frontend:3000
	}
	handle /budget* {
		reverse_proxy budget-frontend:3000
	}
	handle /workout* {
		reverse_proxy workout-frontend:3000
	}
	handle /library* {
		reverse_proxy library-frontend:3000
	}
	handle /chat* {
		reverse_proxy chat-frontend:3000
	}

	# Dashboard frontend serves everything else.
	handle {
		reverse_proxy dashboard-frontend:3000
	}
}
