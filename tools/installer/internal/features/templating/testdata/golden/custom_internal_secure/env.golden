# ==============================================================================
# alfheim: Production Environment
# Generated by alfheim-setup v0.0.0-test on 2026-03-01T12:00:00Z.
#
# This file contains every credential for this installation. Keep it readable
# by its owner only (chmod 600) and never commit it.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE & IAM
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test-postgres_password
POSTGRES_DB=postgres

ZITADEL_DB_HOST=postgres-core
ZITADEL_DB_PORT=5432
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel_user
ZITADEL_DB_PASSWORD=test-zitadel_db_password

# The masterkey must be exactly 32 characters and must never be rotated on an
# existing instance: doing so makes the Zitadel database unreadable.
ZITADEL_MASTERKEY=test-zitadel_masterkey
ZITADEL_EXTERNALDOMAIN=auth.example.com
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true

ZITADEL_ADMIN_EMAIL=ops@example.com
# The login name Zitadel is bootstrapped with is the admin e-mail itself, so
# the operator logs in with the address they entered instead of guessing an
# `admin@auth.<domain>` style name.
ZITADEL_ADMIN_USER=ops@example.com
ZITADEL_ADMIN_PASSWORD=test-zitadel_admin_password
ZITADEL_FIRSTINSTANCE_ORG_NAME=Alfheim
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=${ZITADEL_ADMIN_USER}
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=test-zitadel_firstinstance_org_human_password

# The bootstrap machine user alfheim-setup provisions OIDC clients with. Its
# personal access token is written by Zitadel only on first init
# (ZITADEL_FIRSTINSTANCE_PATPATH); the installer copies it here right after,
# so a lost machinekey file does not strand provisioning on a re-run.
ZITADEL_BOOTSTRAP_USERNAME=alfheim-bootstrap
ZITADEL_BOOTSTRAP_PAT=

# Filled in by the installer's Zitadel provisioning step, between the Edge &
# Identity phase and the Core & Application Stack phase. A fresh render
# always carries the placeholder so `docker compose config` never warns about
# an unset variable before provisioning has run.
ZITADEL_PROJECT_ID=__PROVISIONED__
OIDC_AUDIENCE=__PROVISIONED__
ALFHEIM_WEB_CLIENT_ID=__PROVISIONED__
GRAFANA_OIDC_CLIENT_ID=__PROVISIONED__
GRAFANA_OIDC_CLIENT_SECRET=__PROVISIONED__

# RustFS / MinIO S3 central storage
S3_ROOT_USER=alfheim
S3_ROOT_PASSWORD=test-s3_root_password
S3_ACCESS_KEY=alfheim
S3_SECRET_KEY=test-s3_secret_key
S3_ENDPOINT_URL=http://minio:9000
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=budget-receipts
S3_PUBLIC_URL=https://alfheim.example.com/storage

# ------------------------------------------------------------------------------
# 2. CORE & SERVICE DATABASE CREDENTIALS
# ------------------------------------------------------------------------------
DASHBOARD_POSTGRES_USER=dashboard_user
DASHBOARD_POSTGRES_PASSWORD=test-dashboard_postgres_password
DASHBOARD_POSTGRES_DB=alfheim_dashboard

PANTRY_POSTGRES_USER=pantry_user
PANTRY_POSTGRES_PASSWORD=test-pantry_postgres_password
PANTRY_POSTGRES_DB=alfheim_pantry

SHOPPING_POSTGRES_USER=shopping_user
SHOPPING_POSTGRES_PASSWORD=test-shopping_postgres_password
SHOPPING_POSTGRES_DB=alfheim_shopping

MAINTENANCE_POSTGRES_USER=maintenance_user
MAINTENANCE_POSTGRES_PASSWORD=test-maintenance_postgres_password
MAINTENANCE_POSTGRES_DB=alfheim_maintenance

CHORES_POSTGRES_USER=chores_user
CHORES_POSTGRES_PASSWORD=test-chores_postgres_password
CHORES_POSTGRES_DB=alfheim_chores

BUDGET_POSTGRES_USER=budget_user
BUDGET_POSTGRES_PASSWORD=test-budget_postgres_password
BUDGET_POSTGRES_DB=alfheim_budget

CHAT_POSTGRES_USER=chat_user
CHAT_POSTGRES_PASSWORD=test-chat_postgres_password
CHAT_POSTGRES_DB=alfheim_chat
CHAT_ENCRYPTION_KEY=test-chat_encryption_key
CHAT_ENCRYPTION_KEY_ID=v1

WORKOUT_POSTGRES_USER=workout_user
WORKOUT_POSTGRES_PASSWORD=test-workout_postgres_password
WORKOUT_POSTGRES_DB=alfheim_workout

LIBRARY_POSTGRES_USER=library_user
LIBRARY_POSTGRES_PASSWORD=test-library_postgres_password
LIBRARY_POSTGRES_DB=alfheim_library

# Explicitly constructed DATABASE_URL connections for Python AsyncPG backends.
# When left empty, services construct them from the POSTGRES_* variables above.
DASHBOARD_DATABASE_URL=
PANTRY_DATABASE_URL=
SHOPPING_DATABASE_URL=
MAINTENANCE_DATABASE_URL=
CHORES_DATABASE_URL=
BUDGET_DATABASE_URL=
CHAT_DATABASE_URL=
WORKOUT_DATABASE_URL=
LIBRARY_DATABASE_URL=

# Additional service configuration
PANTRY_BACKEND_URL=http://pantry-backend:8000
CHAT_MCP_SERVERS=pantry=http://pantry-backend:8000/mcp,chores=http://chores-backend:8000/mcp,maintenance=http://maintenance-backend:8000/mcp

# External API keys for enrichment features (optional; leave empty to disable)
GOOGLE_BOOKS_API_KEY=
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 3. DOMAIN, GATEWAY & AUTHENTICATION
# ------------------------------------------------------------------------------
ALFHEIM_BASE_URL=https://alfheim.example.com
DOMAIN=example.com
HOST_HEADER=alfheim.example.com
ALFHEIM_HOST=alfheim.example.com

IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=kroegerleif/alfheim
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# 4. TLS / INGRESS CERTIFICATES
# Strategy: internal
# ------------------------------------------------------------------------------
ALFHEIM_TLS_STRATEGY=internal
ACME_EMAIL=
HETZNER_API_TOKEN=
CLOUDFLARE_API_TOKEN=
ALFHEIM_CERT_MOUNT=
CADDY_TLS_DIRECTIVE=tls internal

NEXT_PUBLIC_FRONTEND_URL=${ALFHEIM_BASE_URL}
NEXT_PUBLIC_API_GATEWAY_URL=${ALFHEIM_BASE_URL}/api

OIDC_ISSUER_URL=https://auth.example.com

NEXT_PUBLIC_OIDC_ISSUER=https://auth.example.com

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD='p$ss"wo rd#='
# GRAFANA_OIDC_CLIENT_ID / _SECRET are provisioned above, alongside the other
# Zitadel-generated credentials.
# URL-encoded ${ALFHEIM_BASE_URL}/grafana/login, used as the post_logout_redirect_uri
# query parameter of Zitadel's end_session endpoint (compose.prod.yaml).
GRAFANA_SIGNOUT_REDIRECT_URL=https%3A%2F%2Falfheim.example.com%2Fgrafana%2Flogin

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT BUILD ARGUMENTS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PANTRY_API_URL=${ALFHEIM_BASE_URL}/api/pantry/api/v1
NEXT_PUBLIC_SHOPPING_API_URL=${ALFHEIM_BASE_URL}/api/shopping/api/v1
NEXT_PUBLIC_CHORES_API_URL=${ALFHEIM_BASE_URL}/api/api/v1/chores
NEXT_PUBLIC_MAINTENANCE_API_URL=${ALFHEIM_BASE_URL}/api/maintenance/api/v1
NEXT_PUBLIC_CHAT_API_URL=${ALFHEIM_BASE_URL}/api/api/v1/chat
NEXT_PUBLIC_DASHBOARD_API_URL=${ALFHEIM_BASE_URL}/api/api/v1
NEXT_PUBLIC_WORKOUT_API_URL=${ALFHEIM_BASE_URL}/api/workout/api/v1
NEXT_PUBLIC_LIBRARY_API_URL=${ALFHEIM_BASE_URL}/api/api/v1/library
NEXT_PUBLIC_BUDGET_API_URL=${ALFHEIM_BASE_URL}/api/budget/api/v1
