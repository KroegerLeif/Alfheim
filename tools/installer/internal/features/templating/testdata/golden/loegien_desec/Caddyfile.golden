# =============================================================================
# alfheim: Caddy Ingress Gateway
# Generated by alfheim-setup v0.0.0-test on 2026-03-01T12:00:00Z.
# Re-run the installer with --reconfigure to regenerate this file.
# =============================================================================

# Global options
{
	admin off
	# rate_limit is a plugin directive without a default position; run it
	# before any other handler so a throttled request never reaches a backend.
	order rate_limit before basic_auth
	# Automatic HTTPS is Caddy's default and must not be disabled here, as it
	# drives DNS-01 issuance. The API token is read from the environment, so
	# this file never contains a credential.
	email ops@loegien.de
	# deSEC needs up to a minute to publish a record on every nameserver,
	# and enforces a 3600 s minimum TTL. If Let's Encrypt validates before
	# the challenge record is everywhere, its resolver caches the stale
	# answer for an hour and every retry in that hour fails too. So wait
	# before asking for validation, and confirm propagation against
	# deSEC's own nameservers rather than a caching resolver. The desec
	# module only accepts its token as a block subdirective.
	cert_issuer acme {
		dns desec {
			token {env.DESEC_TOKEN}
		}
		propagation_delay 90s
		propagation_timeout 10m
		resolvers ns1.desec.io ns2.desec.org
	}
	# Certificate management stays on, but Caddy's own blanket HTTP->HTTPS
	# redirect is disabled: without this, any site here that manages a TLS
	# certificate makes Caddy install a catch-all redirect on port 80 for
	# EVERY host that isn't explicitly routed elsewhere — including this
	# container's own healthcheck hitting http://127.0.0.1/livez, which has
	# no matching certificate and fails the TLS handshake, so the healthcheck
	# never passes (reproduced and confirmed locally). The friendly redirect
	# real visitors expect on the bare domain is added explicitly below
	# instead of relying on this automatic behaviour.
	auto_https disable_redirects
}

# =============================================================================
# Security headers, imported by every site block below.
#
# The "?" prefix only sets a header the upstream did not already send, so
# Zitadel and Grafana keep the headers they ship themselves.
#
# X-Frame-Options / frame-ancestors: no Alfheim app frames another one, and
# neither Zitadel's login UI nor Grafana is embedded anywhere. The only iframe
# (the library PDF viewer) loads a same-origin /storage URL, so SAMEORIGIN is
# the tightest value that does not break it.
#
# Content-Security-Policy is enforced. Zitadel and Grafana send their own
# policy, which the "?" prefix keeps. Next.js emits inline bootstrap scripts
# without nonces, so script-src still allows 'unsafe-inline'; everything else
# is pinned to this origin plus the few third parties the shared UI needs:
# - connect-src: the auth host (the browser talks to Zitadel's OIDC endpoints
#   directly) and Nominatim (AddressAutocomplete).
# - img-src: CARTO map tiles and the Leaflet marker icons (OSMMapViewer).
# =============================================================================
(security_headers) {
	header {
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "SAMEORIGIN"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://cdnjs.cloudflare.com; font-src 'self' data:; connect-src 'self' https://auth.loegien.de https://nominatim.openstreetmap.org; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# =============================================================================
# Rate limits per client IP (mholt/caddy-ratelimit, compiled into the Caddy
# image). Each zone counts requests in a sliding one-minute window; a request
# above the limit gets 429 with Retry-After. A request can match several
# zones and counts against each of them. The ALFHEIM_RATE_LIMIT_* variables
# in .env tune the limits (requests per minute) without regenerating this
# file. {client_ip} is the peer address unless trusted_proxies is set, so
# behind another proxy every client shares that proxy's budget.
#
# - auth_login: form posts to Zitadel's login UI (password, MFA, register).
#   One sign-in takes 2-4 posts, so 30 per minute stops password guessing
#   without hurting a household that shares one public IP.
# - auth: everything else on the auth host. The login and console pages pull
#   dozens of assets, and the OIDC token and JWKS calls land here too.
# - lookup: library and pantry lookups that call ISBN, BGG, TMDB and Open
#   Food Facts upstream and would otherwise burn their quotas.
# - api: every /api/v1 route. Generous: a page load fires several calls.
# - webhook: the unauthenticated, HMAC-signed Home Assistant webhook
#   (POST /api/v1/integrations/home-assistant/events). Automations send a
#   few events per minute; the limit caps signature-guessing floods.
# =============================================================================
(auth_rate_limit) {
	rate_limit {
		zone auth_login {
			match {
				method POST
				path /ui/login/* /ui/v2/login/*
			}
			key {client_ip}
			events {$ALFHEIM_RATE_LIMIT_LOGIN:30}
			window 1m
		}
		zone auth {
			key {client_ip}
			events {$ALFHEIM_RATE_LIMIT_AUTH:600}
			window 1m
		}
	}
}

(api_rate_limit) {
	rate_limit {
		zone webhook {
			match {
				method POST
				path /api/v1/integrations/home-assistant/events
			}
			key {client_ip}
			events {$ALFHEIM_RATE_LIMIT_WEBHOOK:30}
			window 1m
		}
		zone lookup {
			match {
				path /api/v1/library/lookup* /library/api/v1/lookup* /api/v1/pantry/products/barcode/* /pantry/api/v1/products/barcode/*
			}
			key {client_ip}
			events {$ALFHEIM_RATE_LIMIT_LOOKUP:60}
			window 1m
		}
		zone api {
			match {
				path /api/v1/* */api/v1/*
			}
			key {client_ip}
			events {$ALFHEIM_RATE_LIMIT_API:1200}
			window 1m
		}
	}
}

# Answers a throttled request. Browsers navigating to a page get plain text,
# API clients a JSON body; rate_limit already set Retry-After.
(rate_limited) {
	handle_errors 429 {
		# Error routes start without the headers of the failed route.
		import security_headers
		header Cache-Control "no-store"
		@page header Accept *text/html*
		handle @page {
			respond "Too many requests. Try again in a minute." 429
		}
		handle {
			header Content-Type "application/json"
			respond `{"error":"rate_limited","message":"Too many requests. Try again in a minute."}` 429
		}
	}
}

# =============================================================================
# App backends and unavailable apps, imported by the site blocks below.
#
# app_backend <upstream> <health path> proxies to an app backend. Passive
# retries (lb_try_duration) let a request wait briefly for a backend that is
# restarting instead of answering 502 at once; the active health check takes a
# stopped backend out of rotation, so later requests fail fast with 503.
#
# app_unavailable answers a stopped, restarting or missing app (502, 503,
# 504 from any upstream) with a clear error instead of an empty 502: API paths
# get a JSON body, page paths the static page that the Caddy image ships in
# /srv/alfheim-errors (infrastructure/caddy/errors; no external assets, so it
# passes the CSP above). Caddy stays a host and prefix mapper:
# the error routes only replace the failed response.
# =============================================================================
(app_backend) {
	reverse_proxy {args[0]} {
		lb_try_duration 3s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri {args[1]}
		health_interval 15s
		health_timeout 3s
	}
}

(unavailable_json) {
	header Content-Type "application/json"
	respond `{"error":"service_unavailable","message":"This app is not available right now. Try again in a moment."}` 503
}

(app_unavailable) {
	handle_errors 502 503 504 {
		# Error routes start without the headers of the failed route.
		import security_headers
		header Retry-After "30"
		header Cache-Control "no-store"
		@api path */api/v1*
		handle @api {
			import unavailable_json
		}
		handle {
			root * /srv/alfheim-errors
			rewrite * /app-unavailable.html
			file_server {
				status 503
			}
		}
	}
}

# =============================================================================
# 0. IDENTITY PROVIDER DOMAIN (Zitadel OIDC)
# Zitadel is served on its own dedicated host; it does not support sub-path
# hosting. The issuer therefore is the bare origin of this domain.
# =============================================================================
https://auth.loegien.de {

	import security_headers
	import auth_rate_limit
	import rate_limited

	# Defense in depth: /internal/* is the service-to-service API authenticated
	# by ALFHEIM_INTERNAL_TOKEN and must never be reachable from outside.
	handle /internal/* {
		respond 404
	}

	reverse_proxy zitadel:8080 {
		# Zitadel speaks gRPC-Web / HTTP/2 to its own frontend and API.
		transport http {
			versions h2c 1.1
		}
	}
}

# Explicit redirect, since auto_https disable_redirects (see global options)
# no longer adds one automatically: a visitor on plain HTTP still lands on
# HTTPS, but 127.0.0.1 (the container's own healthcheck) is left alone.
http://auth.loegien.de {
	redir https://auth.loegien.de{uri} permanent
}

# =============================================================================
# 1. FRONTEND DOMAIN
# =============================================================================
https://alfheim.loegien.de {

	import security_headers
	import app_unavailable
	import api_rate_limit
	import rate_limited

	# Dedicated ingress healthcheck endpoint, isolated from downstream services.
	handle /livez {
		respond "OK" 200
	}

	# Service-to-service API (ALFHEIM_INTERNAL_TOKEN) is internal only and is
	# never proxied to any upstream.
	handle /internal/* {
		respond 404
	}

	# Bare app paths (/pantry, /chores, ...) are not redirected here: each
	# Next.js app's next-intl middleware owns locale selection (NEXT_LOCALE
	# cookie, Accept-Language, default locale); the gateway only routes.

	# API gateway proxies on the frontend domain, so browsers can issue
	# relative /api/v1/... calls without a CORS preflight.
	#
	# Caddy sorts handle and handle_path blocks together by path length
	# (longest first) and runs only the first match, so these Tier-1
	# household & roles routes win over the generic /api/v1* dashboard route
	# below. The path is forwarded unchanged: the household backend serves
	# /api/v1/households and /api/v1/profile itself. No app slug is a prefix
	# of "households" or "profile", so no /api/v1/<slug>* rule can take them.
	handle /api/v1/households* {
		import app_backend household-backend:8080 /readyz
	}
	handle /api/v1/profile* {
		import app_backend household-backend:8080 /readyz
	}
	handle_path /api/v1/pantry* {
		rewrite * /api/v1{path}
		import app_backend pantry-backend:8000 /readyz
	}
	handle_path /pantry/api/v1* {
		rewrite * /api/v1{path}
		import app_backend pantry-backend:8000 /readyz
	}
	handle /api/v1/shopping* {
		import app_backend shopping-backend:8000 /readyz
	}
	handle_path /shopping/api/v1* {
		rewrite * /api/v1{path}
		import app_backend shopping-backend:8000 /readyz
	}
	handle_path /api/v1/maintenance* {
		rewrite * /api/v1{path}
		import app_backend maintenance-backend:8000 /readyz
	}
	handle_path /maintenance/api/v1* {
		rewrite * /api/v1{path}
		import app_backend maintenance-backend:8000 /readyz
	}
	handle /api/v1/chores* {
		import app_backend chores-backend:8000 /readyz
	}
	handle_path /chores/api/v1* {
		rewrite * /api/v1/chores{path}
		import app_backend chores-backend:8000 /readyz
	}
	handle_path /api/v1/budget* {
		rewrite * /api/v1{path}
		import app_backend budget-backend:8000 /readyz
	}
	handle_path /budget/api/v1* {
		rewrite * /api/v1{path}
		import app_backend budget-backend:8000 /readyz
	}
	handle_path /api/v1/workout* {
		rewrite * /api/v1{path}
		import app_backend workout-backend:8000 /readyz
	}
	handle_path /workout/api/v1* {
		rewrite * /api/v1{path}
		import app_backend workout-backend:8000 /readyz
	}
	handle /api/v1/library* {
		import app_backend library-backend:8000 /readyz
	}
	handle_path /library/api/v1* {
		rewrite * /api/v1/library{path}
		import app_backend library-backend:8000 /readyz
	}
	handle /api/v1/chat* {
		import app_backend chat-backend:8080 /readyz
	}
	handle_path /chat/api/v1* {
		rewrite * /api/v1/chat{path}
		import app_backend chat-backend:8080 /readyz
	}

	# Central dashboard control plane (path preserved).
	handle /api/v1/* {
		import app_backend dashboard-backend:8080 /readyz
	}

	# RustFS object storage (S3_PUBLIC_URL). Browsers PUT and GET presigned
	# URLs here (budget receipts, library manuals); handle_path strips /storage
	# so the signed bucket/key path reaches RustFS unchanged. Objects stay
	# private: RustFS rejects any request without a valid signature.
	handle_path /storage* {
		reverse_proxy rustfs:9000
	}

	# Observability.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Household & roles core frontend (Next.js basePath /household).
	handle /household* {
		reverse_proxy household-frontend:3000
	}

	# Application frontends.
	handle /pantry* {
		reverse_proxy pantry-frontend:3000
	}
	handle /shopping* {
		reverse_proxy shopping-frontend:3010
	}
	handle /maintenance* {
		reverse_proxy maintenance-frontend:3000
	}
	handle /chores* {
		reverse_proxy chores-frontend:3000
	}
	handle /budget* {
		reverse_proxy budget-frontend:3000
	}
	handle /workout* {
		reverse_proxy workout-frontend:3000
	}
	handle /library* {
		reverse_proxy library-frontend:3000
	}
	handle /chat* {
		reverse_proxy chat-frontend:3000
	}

	# Dashboard frontend serves everything else.
	handle {
		reverse_proxy dashboard-frontend:3000
	}
}

# See the identity provider domain block above for why this is explicit.
http://alfheim.loegien.de {
	redir https://alfheim.loegien.de{uri} permanent
}
