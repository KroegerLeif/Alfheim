# Global options
{
	admin off
	auto_https off
}

# =============================================================================
# 1. FRONTEND DOMAIN (alfheim.loegien.de & local development)
# =============================================================================
http://alfheim.loegien.de, http://alfheim.loegien.localhost, http://alfheim {
	# Exact locale redirects for bare base paths
	redir /pantry /pantry/en 302
	redir /pantry/ /pantry/en 302
	redir /shopping /shopping/en 302
	redir /shopping/ /shopping/en 302
	redir /maintenance /maintenance/en 302
	redir /maintenance/ /maintenance/en 302
	redir /chores /chores/de 302
	redir /workout /workout/de 302
	redir /workout/ /workout/de 302
	redir /chat /chat/de 302
	redir /chat/ /chat/de 302
	redir /budget /budget/en 302
	redir /budget/ /budget/en 302

	# Keycloak IAM (Native subpath /auth - NO path stripping)
	handle /auth* {
		reverse_proxy keycloak:8080
	}

	# API Gateway Proxies on Frontend Domain (allows relative /api/v1/... calls without CORS)
	handle_path /api/v1/maintenance* {
		rewrite * /api/v1{path}
		reverse_proxy maintenance-backend:8000
	}
	handle_path /maintenance/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy maintenance-backend:8000
	}

	handle_path /api/v1/pantry* {
		rewrite * /api/v1{path}
		reverse_proxy pantry-backend:8000
	}
	handle_path /pantry/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy pantry-backend:8000
	}

	handle_path /api/v1/shopping* {
		rewrite * /api/v1{path}
		reverse_proxy shopping-backend:8000
	}
	handle_path /shopping/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy shopping-backend:8000
	}

	handle_path /api/v1/workout* {
		rewrite * /api/v1{path}
		reverse_proxy workout-backend:8000
	}
	handle_path /workout/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy workout-backend:8000
	}

	handle_path /api/v1/budget* {
		rewrite * /api/v1{path}
		reverse_proxy budget-backend:8000
	}
	handle_path /budget/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy budget-backend:8000
	}

	handle /api/v1/chores* {
		reverse_proxy chores-backend:8000
	}
	handle_path /chores/api/v1* {
		rewrite * /api/v1/chores{path}
		reverse_proxy chores-backend:8000
	}

	handle /api/v1/chat* {
		reverse_proxy chat-backend:8080
	}
	handle /chat/api/v1* {
		uri strip_prefix /chat
		rewrite * /api/v1/chat{path}
		reverse_proxy chat-backend:8080
	}

	handle /api/v1/* {
		reverse_proxy dashboard-backend:8080
	}

	# RustFS S3 Storage Ingress Gateway & Presigned URL Handler
	handle_path /storage* {
		reverse_proxy rustfs:9000
	}

	# Microfrontend proxies (keep basePath prefix intact for Next.js apps)
	handle /pantry* {
		reverse_proxy pantry-frontend:3000
	}
	handle /shopping* {
		reverse_proxy shopping-frontend:3010
	}
	handle /maintenance* {
		reverse_proxy maintenance-frontend:3000
	}
	handle /chores* {
		reverse_proxy chores-frontend:3000
	}
	handle /budget* {
		reverse_proxy budget-frontend:3000
	}
	handle /workout* {
		reverse_proxy workout-frontend:3000
	}
	handle /chat* {
		reverse_proxy chat-frontend:3000
	}
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Dashboard Frontend Catch-all (Root)
	handle {
		reverse_proxy dashboard-frontend:3000
	}
}

# =============================================================================
# 2. CENTRAL API GATEWAY (api.alfheim.loegien.de & local development)
# =============================================================================
http://api.alfheim.loegien.de, http://api.alfheim.loegien.localhost, http://api.alfheim {
	# Dynamic Origin matching for CORS (Excluding /auth* - Keycloak manages its own CORS)
	@cors_origin {
		not path /auth*
		header Origin *
	}
	@cors_options {
		not path /auth*
		method OPTIONS
	}

	handle @cors_options {
		header @cors_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, X-Household-Id, X-Household-Role"
		header Access-Control-Allow-Credentials "true"
		respond 204
	}

	header @cors_origin ?Access-Control-Allow-Origin "{http.request.header.Origin}"
	header @cors_origin ?Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header @cors_origin ?Access-Control-Allow-Headers "Authorization, Content-Type, X-Household-Id, X-Household-Role"
	header @cors_origin ?Access-Control-Allow-Credentials "true"

	# Keycloak IAM (Native subpath /auth - NO path stripping, Keycloak handles CORS via Web Origins)
	handle /auth* {
		reverse_proxy keycloak:8080
	}

	# Maintenance API
	handle_path /api/v1/maintenance* {
		rewrite * /api/v1{path}
		reverse_proxy maintenance-backend:8000
	}
	handle_path /maintenance/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy maintenance-backend:8000
	}
	handle_path /maintenance* {
		reverse_proxy maintenance-backend:8000
	}
	# Budget API
	handle_path /api/v1/budget* {
		rewrite * /api/v1{path}
		reverse_proxy budget-backend:8000
	}
	handle_path /budget/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy budget-backend:8000
	}
	handle_path /budget* {
		reverse_proxy budget-backend:8000
	}

	# Workout API
	handle_path /api/v1/workout* {
		rewrite * /api/v1{path}
		reverse_proxy workout-backend:8000
	}
	handle_path /workout/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy workout-backend:8000
	}
	handle_path /workout* {
		reverse_proxy workout-backend:8000
	}

	# Pantry API
	handle_path /api/v1/pantry* {
		rewrite * /api/v1{path}
		reverse_proxy pantry-backend:8000
	}
	handle_path /pantry/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy pantry-backend:8000
	}
	handle_path /pantry* {
		reverse_proxy pantry-backend:8000
	}

	# Shopping API
	handle_path /api/v1/shopping* {
		rewrite * /api/v1{path}
		reverse_proxy shopping-backend:8000
	}
	handle_path /shopping/api/v1* {
		rewrite * /api/v1{path}
		reverse_proxy shopping-backend:8000
	}
	handle_path /shopping* {
		reverse_proxy shopping-backend:8000
	}

	# Chores API (NO stripping - expects /api/v1/chores/*)
	handle /api/v1/chores* {
		reverse_proxy chores-backend:8000
	}
	handle_path /chores/api/v1* {
		rewrite * /api/v1/chores{path}
		reverse_proxy chores-backend:8000
	}
	handle /chores* {
		reverse_proxy chores-backend:8000
	}

	# Chat API (NO stripping - Go backend expects /api/v1/chat/*)
	handle /api/v1/chat* {
		reverse_proxy chat-backend:8080
	}
	handle_path /chat/api/v1* {
		rewrite * /api/v1/chat{path}
		reverse_proxy chat-backend:8080
	}

	# Dashboard Backend (NO stripping - Go backend expects /api/v1/apps, /profile, /households, /telemetry)
	handle /api/v1/* {
		reverse_proxy dashboard-backend:8080
	}

	# RustFS S3 Storage Ingress Gateway & Presigned URL Handler
	handle_path /storage* {
		reverse_proxy rustfs:9000
	}

	# Observability & Monitoring UI (Grafana)
	handle /grafana* {
		reverse_proxy grafana:3000
	}
}
