# Global options
{
	admin off
	auto_https off
}

# =============================================================================
# Security headers, imported by every site block below.
#
# The "?" prefix only sets a header the upstream did not already send, so
# Zitadel and Grafana keep the headers they ship themselves.
#
# X-Frame-Options / frame-ancestors: no Alfheim app frames another one, and
# neither Zitadel's login UI nor Grafana is embedded anywhere. The only iframe
# (the library PDF viewer) loads a same-origin /storage URL, so SAMEORIGIN is
# the tightest value that does not break it.
#
# Content-Security-Policy-Report-Only documents the intended baseline but is
# NOT enforced yet: Next.js emits inline bootstrap scripts, so enforcing
# script-src without nonces would break every frontend. Violations show up in
# the browser console. connect-src lists the auth host because the browser
# talks to Zitadel's OIDC endpoints directly.
# HSTS is deliberately absent: the dev stack is plain HTTP.
# =============================================================================
(security_headers) {
	header {
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "SAMEORIGIN"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Content-Security-Policy "frame-ancestors 'self'"
		?Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://auth.{$ALFHEIM_HOST:alfheim.loegien.de} https://auth.{$ALFHEIM_HOST:alfheim.loegien.de} http://auth.alfheim.loegien.localhost https://auth.alfheim.loegien.localhost; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

# =============================================================================
# App backends and unavailable apps, imported by the site blocks below.
#
# app_backend <upstream> <health path> proxies to an app backend. Passive
# retries (lb_try_duration) let a request wait briefly for a backend that is
# restarting instead of answering 502 at once; the active health check takes a
# stopped backend out of rotation, so later requests fail fast with 503.
#
# app_unavailable answers a stopped, restarting or missing app (502, 503,
# 504 from any upstream) with a clear error instead of an empty 502: API paths
# get a JSON body, page paths the static page from errors/ (no external
# assets, so it passes the CSP above). Caddy stays a host and prefix mapper:
# the error routes only replace the failed response.
# =============================================================================
(app_backend) {
	reverse_proxy {args[0]} {
		lb_try_duration 3s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri {args[1]}
		health_interval 15s
		health_timeout 3s
	}
}

(unavailable_json) {
	header Content-Type "application/json"
	respond `{"error":"service_unavailable","message":"This app is not available right now. Try again in a moment."}` 503
}

(app_unavailable) {
	handle_errors 502 503 504 {
		# Error routes start without the headers of the failed route.
		import security_headers
		header Retry-After "30"
		header Cache-Control "no-store"
		@api path */api/v1*
		handle @api {
			import unavailable_json
		}
		handle {
			root * /srv/alfheim-errors
			rewrite * /app-unavailable.html
			file_server {
				status 503
			}
		}
	}
}

(api_unavailable) {
	handle_errors 502 503 504 {
		# Error routes start without the headers of the failed route.
		import security_headers
		header Retry-After "30"
		header Cache-Control "no-store"
		import unavailable_json
	}
}

# =============================================================================
# 0. IDENTITY PROVIDER DOMAIN (Zitadel OIDC)
# Zitadel is served on its own dedicated host; it does not support sub-path
# hosting. The issuer therefore is the bare origin of these domains.
# =============================================================================
http://auth.{$ALFHEIM_HOST:alfheim.loegien.de}, https://auth.{$ALFHEIM_HOST:alfheim.loegien.de}, http://auth.loegien.de, https://auth.loegien.de, http://auth.alfheim.loegien.localhost, https://auth.alfheim.loegien.localhost {
	{$CADDY_TLS_DIRECTIVE:}

	import security_headers

	reverse_proxy zitadel:8080 {
		# Zitadel speaks gRPC-Web / HTTP/2 to its own frontend and API.
		transport http {
			versions h2c 1.1
		}
	}
}

# =============================================================================
# 1. FRONTEND DOMAIN (alfheim.loegien.de & local development)
# =============================================================================
http://{$ALFHEIM_HOST:alfheim.loegien.de}, https://{$ALFHEIM_HOST:alfheim.loegien.de}, http://alfheim.loegien.localhost, https://alfheim.loegien.localhost, http://alfheim, https://alfheim, http://localhost, http://127.0.0.1 {
	{$CADDY_TLS_DIRECTIVE:}

	import security_headers
	import app_unavailable

	# Dedicated Ingress Gateway Healthcheck Endpoint (isolated from downstream services)
	handle /livez {
		respond "OK" 200
	}

	# Bare app paths (/pantry, /chores, ...) are not redirected here: each
	# Next.js app's next-intl middleware owns locale selection (NEXT_LOCALE
	# cookie, Accept-Language, default locale); the gateway only routes.

	# API Gateway Proxies on Frontend Domain (allows relative /api/v1/... calls without CORS)
	handle_path /api/v1/maintenance* {
		rewrite * /api/v1{path}
		import app_backend maintenance-backend:8000 /api/v1/health
	}
	handle_path /maintenance/api/v1* {
		rewrite * /api/v1{path}
		import app_backend maintenance-backend:8000 /api/v1/health
	}

	handle_path /api/v1/pantry* {
		rewrite * /api/v1{path}
		import app_backend pantry-backend:8000 /api/v1/health
	}
	handle_path /pantry/api/v1* {
		rewrite * /api/v1{path}
		import app_backend pantry-backend:8000 /api/v1/health
	}

	# Pass-through: the shopping backend already serves /api/v1/shopping-lists,
	# /api/v1/shopping/items and /api/v1/shopping-history, so stripping the prefix
	# would turn them into /api/v1-lists and /api/v1/items (404).
	handle /api/v1/shopping* {
		import app_backend shopping-backend:8000 /health
	}
	handle_path /shopping/api/v1* {
		rewrite * /api/v1{path}
		import app_backend shopping-backend:8000 /health
	}

	handle_path /api/v1/workout* {
		rewrite * /api/v1{path}
		import app_backend workout-backend:8000 /api/v1/health
	}
	handle_path /workout/api/v1* {
		rewrite * /api/v1{path}
		import app_backend workout-backend:8000 /api/v1/health
	}

	handle_path /api/v1/budget* {
		rewrite * /api/v1{path}
		import app_backend budget-backend:8000 /healthz
	}
	handle_path /budget/api/v1* {
		rewrite * /api/v1{path}
		import app_backend budget-backend:8000 /healthz
	}

	handle /api/v1/chores* {
		import app_backend chores-backend:8000 /api/v1/health
	}
	handle_path /chores/api/v1* {
		rewrite * /api/v1/chores{path}
		import app_backend chores-backend:8000 /api/v1/health
	}

	handle /api/v1/chat* {
		import app_backend chat-backend:8080 /api/v1/chat/health
	}
	handle_path /chat/api/v1* {
		rewrite * /api/v1/chat{path}
		import app_backend chat-backend:8080 /api/v1/chat/health
	}

	handle /api/v1/library* {
		import app_backend library-backend:8000 /health
	}
	handle_path /library/api/v1* {
		rewrite * /api/v1/library{path}
		import app_backend library-backend:8000 /health
	}

	# Household app (core/household): households, memberships and the user
	# profile, path preserved. Caddy sorts handle blocks by path length, so
	# these win over the dashboard /api/v1/* catch-all below.
	handle /api/v1/households* {
		import app_backend household-backend:8080 /healthz
	}
	handle /api/v1/profile* {
		import app_backend household-backend:8080 /healthz
	}

	handle /api/v1/* {
		import app_backend dashboard-backend:8080 /healthz
	}

	# Service-to-service endpoints (ALFHEIM_INTERNAL_TOKEN) are never exposed
	# through the gateway.
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	# RustFS S3 Storage Ingress Gateway & Presigned URL Handler
	handle_path /storage* {
		reverse_proxy rustfs:9000
	}

	# Microfrontend proxies (keep basePath prefix intact for Next.js apps)
	handle /household* {
		reverse_proxy household-frontend:3000
	}
	handle /pantry* {
		reverse_proxy pantry-frontend:3000
	}
	handle /shopping* {
		reverse_proxy shopping-frontend:3010
	}
	handle /maintenance* {
		reverse_proxy maintenance-frontend:3000
	}
	handle /chores* {
		reverse_proxy chores-frontend:3000
	}
	handle /library* {
		reverse_proxy library-frontend:3000
	}
	handle /budget* {
		reverse_proxy budget-frontend:3000
	}
	handle /workout* {
		reverse_proxy workout-frontend:3000
	}
	handle /chat* {
		reverse_proxy chat-frontend:3000
	}
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Dashboard Frontend Catch-all (Root)
	handle {
		reverse_proxy dashboard-frontend:3000
	}
}

# =============================================================================
# 2. CENTRAL API GATEWAY (api.alfheim.loegien.de & local development)
# =============================================================================
http://api.{$ALFHEIM_HOST:alfheim.loegien.de}, https://api.{$ALFHEIM_HOST:alfheim.loegien.de}, http://api.alfheim.loegien.localhost, https://api.alfheim.loegien.localhost, http://api.alfheim, https://api.alfheim {
	{$CADDY_TLS_DIRECTIVE:}

	import security_headers
	import api_unavailable

	# No CORS handling: every frontend calls the API through its own origin
	# (NEXT_PUBLIC_API_URL is derived from ALFHEIM_BASE_URL, see the frontend
	# host above), so browsers never issue cross-origin requests to this host.
	# Reflecting arbitrary origins together with credentials would let any
	# website read authenticated API responses.

	# Maintenance API
	handle_path /api/v1/maintenance* {
		rewrite * /api/v1{path}
		import app_backend maintenance-backend:8000 /api/v1/health
	}
	handle_path /maintenance/api/v1* {
		rewrite * /api/v1{path}
		import app_backend maintenance-backend:8000 /api/v1/health
	}
	handle_path /maintenance* {
		rewrite * /api/v1{path}
		import app_backend maintenance-backend:8000 /api/v1/health
	}

	# Budget API
	handle_path /api/v1/budget* {
		rewrite * /api/v1{path}
		import app_backend budget-backend:8000 /healthz
	}
	handle_path /budget/api/v1* {
		rewrite * /api/v1{path}
		import app_backend budget-backend:8000 /healthz
	}
	handle_path /budget* {
		rewrite * /api/v1{path}
		import app_backend budget-backend:8000 /healthz
	}

	# Workout API
	handle_path /api/v1/workout* {
		rewrite * /api/v1{path}
		import app_backend workout-backend:8000 /api/v1/health
	}
	handle_path /workout/api/v1* {
		rewrite * /api/v1{path}
		import app_backend workout-backend:8000 /api/v1/health
	}
	handle_path /workout* {
		rewrite * /api/v1{path}
		import app_backend workout-backend:8000 /api/v1/health
	}

	# Pantry API
	handle_path /api/v1/pantry* {
		rewrite * /api/v1{path}
		import app_backend pantry-backend:8000 /api/v1/health
	}
	handle_path /pantry/api/v1* {
		rewrite * /api/v1{path}
		import app_backend pantry-backend:8000 /api/v1/health
	}
	handle_path /pantry* {
		rewrite * /api/v1{path}
		import app_backend pantry-backend:8000 /api/v1/health
	}

	# Shopping API
	# Pass-through: the shopping backend already serves /api/v1/shopping-lists,
	# /api/v1/shopping/items and /api/v1/shopping-history, so stripping the prefix
	# would turn them into /api/v1-lists and /api/v1/items (404).
	handle /api/v1/shopping* {
		import app_backend shopping-backend:8000 /health
	}
	handle_path /shopping/api/v1* {
		rewrite * /api/v1{path}
		import app_backend shopping-backend:8000 /health
	}
	handle_path /shopping* {
		rewrite * /api/v1{path}
		import app_backend shopping-backend:8000 /health
	}

	# Chores API
	handle /api/v1/chores* {
		import app_backend chores-backend:8000 /api/v1/health
	}
	handle_path /chores/api/v1* {
		rewrite * /api/v1/chores{path}
		import app_backend chores-backend:8000 /api/v1/health
	}
	handle_path /chores* {
		rewrite * /api/v1/chores{path}
		import app_backend chores-backend:8000 /api/v1/health
	}

	# Library API
	handle /api/v1/library* {
		import app_backend library-backend:8000 /health
	}
	handle_path /library/api/v1* {
		rewrite * /api/v1/library{path}
		import app_backend library-backend:8000 /health
	}
	handle_path /library* {
		rewrite * /api/v1/library{path}
		import app_backend library-backend:8000 /health
	}

	# Chat API
	handle /api/v1/chat* {
		import app_backend chat-backend:8080 /api/v1/chat/health
	}
	handle_path /chat/api/v1* {
		rewrite * /api/v1/chat{path}
		import app_backend chat-backend:8080 /api/v1/chat/health
	}
	handle_path /chat* {
		rewrite * /api/v1/chat{path}
		import app_backend chat-backend:8080 /api/v1/chat/health
	}

	# Household API (core/household), path preserved. Same routes as on the
	# frontend host; longer paths than the dashboard catch-all, so they win.
	handle /api/v1/households* {
		import app_backend household-backend:8080 /healthz
	}
	handle /api/v1/profile* {
		import app_backend household-backend:8080 /healthz
	}

	# Dashboard Backend (Go backend: /api/v1/apps, /telemetry, ...)
	handle /api/v1/* {
		import app_backend dashboard-backend:8080 /healthz
	}

	# Service-to-service endpoints are never exposed through the gateway.
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	# RustFS S3 Storage Ingress Gateway & Presigned URL Handler
	handle_path /storage* {
		reverse_proxy rustfs:9000
	}

	# Observability & Monitoring UI (Grafana)
	handle /grafana* {
		reverse_proxy grafana:3000
	}
}
