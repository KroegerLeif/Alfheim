      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(rate({__name__=\"http.server.duration_count\"}[1m])) by (\"service.name\")",
          "legendFormat": "{{service.name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
