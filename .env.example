# ==============================================================================
# alfheim: Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE & IAM (infrastructure/compose.yml)
# ------------------------------------------------------------------------------

# PostgreSQL for Keycloak IAM
POSTGRES_USER=alfheim_admin
POSTGRES_PASSWORD=super_secret_local_password
POSTGRES_DB=keycloak_db

# Keycloak Core Settings
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres-iam:5432/keycloak_db
KC_DB_USERNAME=alfheim_admin
KC_DB_PASSWORD=super_secret_local_password

# ------------------------------------------------------------------------------
# 2. PANTRY MODULE APP STACK (apps/pantry/compose.yml)
# ------------------------------------------------------------------------------

# Pantry Backend Relational Database
PANTRY_POSTGRES_USER=postgres
PANTRY_POSTGRES_PASSWORD=postgres
PANTRY_POSTGRES_DB=pantry

# Backend Service Config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@pantry-db:5432/pantry
PORT=8000

# Central Domain Configuration
NEXT_PUBLIC_FRONTEND_URL=http://alfheim.loegien.localhost
NEXT_PUBLIC_API_GATEWAY_URL=http://api.alfheim.loegien.localhost

# Backend Authentication via Central IAM Gateway
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_PUBLIC_URL=http://api.alfheim.loegien.localhost/auth
KEYCLOAK_REALM=alfheim
KEYCLOAK_CLIENT_ID=pantry-backend

# OpenTelemetry Exporter Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317

# Frontend Client Build Arguments (Routes requests to Caddy Central API Gateway)
NEXT_PUBLIC_PANTRY_API_URL=http://api.alfheim.loegien.localhost/pantry/api/v1
NEXT_PUBLIC_SHOPPING_API_URL=http://api.alfheim.loegien.localhost/shopping/api/v1
NEXT_PUBLIC_CHORES_API_URL=http://api.alfheim.loegien.localhost/api/v1/chores
NEXT_PUBLIC_MAINTENANCE_API_URL=http://api.alfheim.loegien.localhost/maintenance/api/v1
NEXT_PUBLIC_DASHBOARD_API_URL=http://api.alfheim.loegien.localhost/api/v1
