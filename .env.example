# ==============================================================================
# alfheim: Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE & IAM (infrastructure/compose.yml)
# ------------------------------------------------------------------------------

# PostgreSQL Core Container Defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=super_secret_local_password
POSTGRES_DB=postgres

# IAM / Zitadel Database Credentials (database name is literally "zitadel")
ZITADEL_DB_HOST=postgres-core
ZITADEL_DB_PORT=5432
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel_user
ZITADEL_DB_PASSWORD=postgres

# Zitadel Core Settings
# Generate a real 32-character master key for any non-local environment:
#   openssl rand -hex 16
# (scripts/init-env.sh does this automatically when generating a production .env)
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_EXTERNALDOMAIN=auth.alfheim.loegien.localhost
ZITADEL_EXTERNALPORT=80
ZITADEL_EXTERNALSECURE=false

# Zitadel first-instance bootstrap (initial organisation + admin human user).
# ZITADEL_ADMIN_USER / ZITADEL_ADMIN_PASSWORD are the canonical admin identity;
# scripts/init-env.sh regenerates the password for non-local environments.
ZITADEL_ADMIN_USER=admin
ZITADEL_ADMIN_PASSWORD=Password1!
ZITADEL_FIRSTINSTANCE_ORG_NAME=Alfheim
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=${ZITADEL_ADMIN_USER}
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=${ZITADEL_ADMIN_PASSWORD}

# Local development only: the machine user whose personal access token
# `alfheim-setup provision` (invoked by scripts/up.sh; see
# tools/installer/internal/app/provision_cmd.go) uses to provision OIDC
# clients through the Management API. Production installs provision the
# same way, as part of the installer's own bootstrap flow.
ZITADEL_BOOTSTRAP_USERNAME=bootstrap

# RustFS S3 Central Storage
S3_ROOT_USER=minioadmin
S3_ROOT_PASSWORD=minioadmin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT_URL=http://rustfs:9000
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET_NAME=budget-receipts
S3_PUBLIC_URL=https://alfheim.loegien.de/storage

# ------------------------------------------------------------------------------
# 2. CORE & SERVICES DATABASE CREDENTIALS & CONFIGURATION
# ------------------------------------------------------------------------------

# Control Plane Dashboard DB
DASHBOARD_POSTGRES_USER=dashboard_user
DASHBOARD_POSTGRES_PASSWORD=postgres
DASHBOARD_POSTGRES_DB=alfheim_dashboard

# Pantry Backend DB
PANTRY_POSTGRES_USER=pantry_user
PANTRY_POSTGRES_PASSWORD=postgres
PANTRY_POSTGRES_DB=alfheim_pantry

# Shopping Backend DB
SHOPPING_POSTGRES_USER=shopping_user
SHOPPING_POSTGRES_PASSWORD=postgres
SHOPPING_POSTGRES_DB=alfheim_shopping

# Maintenance Backend DB
MAINTENANCE_POSTGRES_USER=maintenance_user
MAINTENANCE_POSTGRES_PASSWORD=postgres
MAINTENANCE_POSTGRES_DB=alfheim_maintenance

# Chores Backend DB
CHORES_POSTGRES_USER=chores_user
CHORES_POSTGRES_PASSWORD=postgres
CHORES_POSTGRES_DB=alfheim_chores

# Budget Backend DB
BUDGET_POSTGRES_USER=budget_user
BUDGET_POSTGRES_PASSWORD=postgres
BUDGET_POSTGRES_DB=alfheim_budget

# Chat Backend DB & Encryption
CHAT_POSTGRES_USER=chat_user
CHAT_POSTGRES_PASSWORD=postgres
CHAT_POSTGRES_DB=alfheim_chat
CHAT_ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY_ID=v1

# Workout Backend DB
WORKOUT_POSTGRES_USER=workout_user
WORKOUT_POSTGRES_PASSWORD=postgres
WORKOUT_POSTGRES_DB=alfheim_workout

# Library Backend DB
LIBRARY_POSTGRES_USER=library_user
LIBRARY_POSTGRES_PASSWORD=postgres
LIBRARY_POSTGRES_DB=alfheim_library

# Explicitly constructed DATABASE_URL connections for Python AsyncPG backends.
# When left empty, services construct them from the POSTGRES_* variables above.
DASHBOARD_DATABASE_URL=
PANTRY_DATABASE_URL=
SHOPPING_DATABASE_URL=
MAINTENANCE_DATABASE_URL=
CHORES_DATABASE_URL=
BUDGET_DATABASE_URL=
CHAT_DATABASE_URL=
WORKOUT_DATABASE_URL=
LIBRARY_DATABASE_URL=

# Additional service configuration
PANTRY_BACKEND_URL=http://pantry-backend:8000
CHAT_MCP_SERVERS=pantry=http://pantry-backend:8000/mcp,chores=http://chores-backend:8000/mcp,maintenance=http://maintenance-backend:8000/mcp

# External API keys for enrichment features (optional; leave empty to disable)
GOOGLE_BOOKS_API_KEY=
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 3. DOMAIN, GATEWAY & AUTHENTICATION SETTINGS
# ------------------------------------------------------------------------------

# Central Domain Configuration
ALFHEIM_BASE_URL=https://alfheim.loegien.de
DOMAIN=loegien.de
HOST_HEADER=alfheim.loegien.de
ALFHEIM_HOST=alfheim.loegien.de

# Container Image Registry & Repository Configuration
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=kroegerleif/alfheim
IMAGE_TAG=latest

# Optional Caddy TLS Directive (leave empty for plain HTTP / auto HTTPS, or set to "tls internal" for self-signed certificates)
CADDY_TLS_DIRECTIVE=

# ACME Certificate Generation (required for automatic HTTPS; see docs/en/how-to/hetzner-dns-tls.md for setup)
ACME_EMAIL=
HETZNER_API_TOKEN=
CLOUDFLARE_API_TOKEN=

NEXT_PUBLIC_FRONTEND_URL=${ALFHEIM_BASE_URL}
NEXT_PUBLIC_API_GATEWAY_URL=${ALFHEIM_BASE_URL}/api

# Generic OIDC verification (dashboard backend)
# OIDC_ISSUER_URL must be the canonical issuer; the backend discovers the JWKS
# URI from {OIDC_ISSUER_URL}/.well-known/openid-configuration and requires the
# token `iss` claim to match it exactly.
OIDC_ISSUER_URL=https://auth.loegien.de
OIDC_AUDIENCE=alfheim

# Internal base URL for server-to-server OIDC calls (token exchange, userinfo)
# that stay inside the container network and never traverse the ingress.
OIDC_INTERNAL_URL=http://zitadel:8080

# Generic OIDC Authorization Code + PKCE flow (dashboard frontend, browser-facing)
NEXT_PUBLIC_OIDC_ISSUER=https://auth.loegien.de
NEXT_PUBLIC_OIDC_CLIENT_ID=dashboard-frontend
NEXT_PUBLIC_OIDC_REDIRECT_URI=${ALFHEIM_BASE_URL}/

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------

# OpenTelemetry Exporter Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Grafana Observability & Zitadel OIDC SSO
# Zitadel generates the client id and returns the secret exactly once, so these
# two placeholders are overwritten by `alfheim-setup provision` (which
# scripts/up.sh runs) rather than being configured by hand.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_OIDC_CLIENT_ID=alfheim-grafana
GRAFANA_OIDC_CLIENT_SECRET=alfheim-grafana-secret

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT BUILD ARGUMENTS (Routes requests to Caddy API Gateway)
# ------------------------------------------------------------------------------

# Frontend sub-route derivations (routed via Caddy path-proxying)
NEXT_PUBLIC_PANTRY_API_URL=${ALFHEIM_BASE_URL}/api/pantry/api/v1
NEXT_PUBLIC_SHOPPING_API_URL=${ALFHEIM_BASE_URL}/api/shopping/api/v1
NEXT_PUBLIC_CHORES_API_URL=${ALFHEIM_BASE_URL}/api/api/v1/chores
NEXT_PUBLIC_MAINTENANCE_API_URL=${ALFHEIM_BASE_URL}/api/maintenance/api/v1
NEXT_PUBLIC_CHAT_API_URL=${ALFHEIM_BASE_URL}/api/api/v1/chat
NEXT_PUBLIC_DASHBOARD_API_URL=${ALFHEIM_BASE_URL}/api/api/v1
NEXT_PUBLIC_WORKOUT_API_URL=${ALFHEIM_BASE_URL}/api/workout/api/v1
NEXT_PUBLIC_LIBRARY_API_URL=${ALFHEIM_BASE_URL}/api/api/v1/library
NEXT_PUBLIC_BUDGET_API_URL=${ALFHEIM_BASE_URL}/api/budget/api/v1
