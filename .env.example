# ==============================================================================
# loeger-os: Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE & IAM (infrastructure/compose.yml)
# ------------------------------------------------------------------------------

# PostgreSQL for Keycloak IAM
POSTGRES_USER=loeger_admin
POSTGRES_PASSWORD=super_secret_local_password
POSTGRES_DB=keycloak_db

# Keycloak Core Settings
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres-iam:5432/keycloak_db
KC_DB_USERNAME=loeger_admin
KC_DB_PASSWORD=super_secret_local_password

# ------------------------------------------------------------------------------
# 2. PANTRY MODULE APP STACK (apps/pantry/compose.yml)
# ------------------------------------------------------------------------------

# Pantry Backend Relational Database
PANTRY_POSTGRES_USER=postgres
PANTRY_POSTGRES_PASSWORD=postgres
PANTRY_POSTGRES_DB=pantry

# Backend Service Config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@pantry-db:5432/pantry
PORT=8000

# Backend Authentication via Central IAM
KEYCLOAK_URL=http://loeger-os.local/auth
KEYCLOAK_REALM=loeger-os
KEYCLOAK_CLIENT_ID=pantry-backend

# OpenTelemetry Exporter Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Frontend Client Build Argument
# Configures browser requests to route relative to the Nginx gateway
NEXT_PUBLIC_API_URL=/pantry/api
